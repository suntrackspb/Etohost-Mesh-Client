  "fixed_sql": [
    {
      "name": "nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nodes\" (\"num\" INTEGER NOT NULL, \"user_id\" TEXT NOT NULL DEFAULT '', \"long_name\" TEXT NOT NULL DEFAULT '', \"short_name\" TEXT NOT NULL DEFAULT '', \"hw_model\" INTEGER NOT NULL DEFAULT 0, \"role\" INTEGER NOT NULL DEFAULT 0, \"public_key\" BLOB NULL, \"new_public_key\" BLOB NULL, \"is_unmessagable\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_unmessagable\" IN (0, 1)), \"has_xeddsa_signed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_xeddsa_signed\" IN (0, 1)), \"last_heard\" TEXT NULL, \"snr\" REAL NULL, \"hops_away\" INTEGER NULL, \"via_mqtt\" INTEGER NOT NULL DEFAULT 0 CHECK (\"via_mqtt\" IN (0, 1)), \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"is_ignored\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_ignored\" IN (0, 1)), \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"altitude\" INTEGER NULL, \"battery_level\" INTEGER NULL, \"voltage\" REAL NULL, \"channel_utilization\" REAL NULL, \"air_util_tx\" REAL NULL, \"uptime_seconds\" INTEGER NULL, \"rssi\" INTEGER NULL, \"modem_preset\" TEXT NULL, \"on_radio\" INTEGER NOT NULL DEFAULT 0 CHECK (\"on_radio\" IN (0, 1)), \"on_mirror\" INTEGER NOT NULL DEFAULT 0 CHECK (\"on_mirror\" IN (0, 1)), PRIMARY KEY (\"num\"));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"packet_id\" INTEGER NOT NULL, \"from_num\" INTEGER NOT NULL, \"to_num\" INTEGER NOT NULL, \"channel\" INTEGER NULL, \"channel_key\" TEXT NOT NULL DEFAULT '', \"body\" TEXT NOT NULL, \"rx_time\" TEXT NOT NULL, \"is_outgoing\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_outgoing\" IN (0, 1)), \"reply_id\" INTEGER NULL, \"emoji\" INTEGER NOT NULL DEFAULT 0, \"rx_snr\" REAL NULL, \"rx_rssi\" INTEGER NULL, \"hop_start\" INTEGER NULL, \"hop_limit\" INTEGER NULL, \"via_mqtt\" INTEGER NOT NULL DEFAULT 0 CHECK (\"via_mqtt\" IN (0, 1)), \"pki_encrypted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pki_encrypted\" IN (0, 1)), \"xeddsa_signed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"xeddsa_signed\" IN (0, 1)), \"ack_proof\" INTEGER NULL, \"ack_state\" INTEGER NOT NULL DEFAULT 0, \"ack_error\" INTEGER NULL, \"heard_on_radio\" INTEGER NOT NULL DEFAULT 0 CHECK (\"heard_on_radio\" IN (0, 1)), \"heard_on_mirror\" INTEGER NOT NULL DEFAULT 0 CHECK (\"heard_on_mirror\" IN (0, 1)), \"mirror_id\" INTEGER NULL UNIQUE, \"relay_count\" INTEGER NOT NULL DEFAULT 0, \"is_bot\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_bot\" IN (0, 1)), UNIQUE (\"packet_id\", \"from_num\"));"
        }
      ]
    },
    {
      "name": "channels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"channels\" (\"index\" INTEGER NOT NULL, \"name\" TEXT NOT NULL DEFAULT '', \"role\" INTEGER NOT NULL DEFAULT 0, \"psk\" BLOB NULL, \"settings\" BLOB NULL, PRIMARY KEY (\"index\"));"
        }
      ]
    },
    {
      "name": "positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"positions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"node_num\" INTEGER NOT NULL, \"time\" TEXT NOT NULL, \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"altitude\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "telemetry_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"telemetry_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"node_num\" INTEGER NOT NULL, \"time\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"data\" BLOB NOT NULL);"
        }
      ]
    },
    {
      "name": "traceroutes",
